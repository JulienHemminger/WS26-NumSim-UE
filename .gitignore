# --- CMake build directories ---
build/
bin/
lib/

# Catch any generic build folders anywhere in the subdirectories
**/build/
**/bin/
**/obj/

# --- Compiled Object files & Binaries ---
*.o
*.obj
*.a
*.lib
*.so
*.dylib
*.exe
a.out

